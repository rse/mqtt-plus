{
    "name":                           "mqtt-plus",
    "version":                        "1.4.25",
    "description":                    "MQTT Communication Patterns",
    "keywords":                       [   "mqtt",
                                          "event", "emit",
                                          "service", "call", "rpc", "request", "response",
                                          "resource", "push", "fetch" ],
    "license":                        "MIT",
    "repository":                     { "type": "git", "url": "git+https://github.com/rse/mqtt-plus.git" },
    "homepage":                       "https://github.com/rse/mqtt-plus",
    "bugs":                           "https://github.com/rse/mqtt-plus/issues",
    "author": {
        "name":                       "Dr. Ralf S. Engelschall",
        "email":                      "rse@engelschall.com",
        "url":                        "http://engelschall.com"
    },
    "type":                           "module",
    "types":                          "./dst-stage1/mqtt-plus.d.ts",
    "module":                         "./dst-stage2/mqtt-plus.esm.js",
    "main":                           "./dst-stage2/mqtt-plus.cjs.cjs",
    "browser":                        "./dst-stage2/mqtt-plus.umd.js",
    "exports": {
        ".": {
            "import":                 { "types": "./dst-stage1/mqtt-plus.d.ts", "default": "./dst-stage2/mqtt-plus.esm.js" },
            "require":                { "types": "./dst-stage1/mqtt-plus.d.ts", "default": "./dst-stage2/mqtt-plus.cjs.cjs" }
        },
        "./esm":                      { "types": "./dst-stage1/mqtt-plus.d.ts", "default": "./dst-stage2/mqtt-plus.esm.js" },
        "./cjs":                      { "types": "./dst-stage1/mqtt-plus.d.ts", "default": "./dst-stage2/mqtt-plus.cjs.cjs" },
        "./umd":                      { "types": "./dst-stage1/mqtt-plus.d.ts", "default": "./dst-stage2/mqtt-plus.umd.js" }
    },
    "devDependencies": {
        "patch-package":              "8.0.1",
        "@rse/stx":                   "1.1.6",
        "shx":                        "0.4.0",
        "eslint":                     "10.8.0",
        "globals":                    "17.9.0",
        "@eslint/js":                 "10.0.1",
        "@eslint/eslintrc":           "3.3.6",
        "knip":                       "6.32.0",
        "jiti":                       "2.7.0",
        "tsx":                        "4.23.9",
        "mocha":                      "11.8.0",
        "chai":                       "6.2.2",
        "sinon-chai":                 "4.0.1",
        "sinon":                      "22.1.0",
        "c8":                         "12.0.0",
        "source-map-support":         "0.5.21",
        "typescript":                 "6.0.3",
        "typescript-eslint":          "8.66.0",
        "@typescript-eslint/parser":  "8.66.0",
        "mqtt":                       "5.15.2",
        "aedes":                      "1.1.1",
        "mosquitto":                  "1.1.0",
        "textframe":                  "1.2.1",
        "vite":                       "8.2.1",
        "vite-plugin-node-polyfills": "0.28.0",
        "@rollup/plugin-replace":     "6.0.3",
        "@wroud/vite-plugin-tsc":     "0.12.3",
        "@terrastruct/d2":            "0.1.33",
        "chokidar-cli":               "3.0.0",
        "chalk":                      "6.0.0",
        "open-cli":                   "9.0.0",
        "cross-env":                  "10.1.0",

        "@types/node":                "26.1.2",
        "@types/mocha":               "10.0.10",
        "@types/chai":                "5.2.3",
        "@types/sinon-chai":          "4.0.0",
        "@types/sinon":               "22.0.0"
    },
    "peerDependencies": {
        "mqtt":                       ">=4.0.0"
    },
    "overrides": {
        "vite-plugin-node-polyfills":           { "vite": ">=7.0.0" }
    },
    "allowScripts": {
        "fsevents":                   true,
        "esbuild":                    true
    },
    "dependencies": {
        "nanoid":                     "6.0.1",
        "cbor2":                      "2.3.0",
        "p-lazy":                     "5.0.0",
        "valibot":                    "1.4.2",
        "jose":                       "6.2.8",
        "@stablelib/pbkdf2":          "2.0.1",
        "@stablelib/sha256":          "2.0.1"
    },
    "engines": {
        "node":                       ">=20.0.0"
    },
    "scripts": {
        "prepare":                    "npm start patch-apply",
        "prepublishOnly":             "npm start build",
        "start":                      "stx -v4 -c etc/stx.conf",
        "test":                       "npm start test"
    }
}
