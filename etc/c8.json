{
    "all":                 false,
    "reports-dir":         "tst/.c8",
    "extension":           [ ".ts", ".js" ],
    "src":                 [ "." ],
    "include":             [ "src/**/*.ts" ],
    "exclude":             [ "node_modules/**/*" ],
    "exclude-after-remap": true,
    "check-coverage":      true,
    "statements":          90,
    "branches":            70,
    "functions":           90,
    "lines":               90,
    "reporter":            [ "text", "html" ],
    "clean":               true
}
