{
    "all":            true,
    "src":            [ "./src" ],
    "extension":      [ ".ts" ],
    "include":        [ "src/**/*.ts" ],
    "exclude":        [ "tst/**/*.spec.ts" ],
    "check-coverage": true,
    "lines":          90,
    "functions":      90,
    "branches":       90,
    "statements":     90,
    "reporter":       [ "text" ]
}
